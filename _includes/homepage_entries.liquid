<div class="news">
  <div class="table-responsive">
    <table class="table table-sm table-borderless">
      {% for item in include.entries %}
        <tr>
          <th scope="row" style="width: 20%">{{ item.date }}</th>
          <td>
            {% if item.url %}
              <a class="news-title" href="{{ item.url }}">{{ item.title }}</a>
            {% else %}
              <span class="news-title">{{ item.title }}</span>
            {% endif %}
            {% if item.description %}
              <br>
              {{ item.description }}
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </table>
  </div>
</div>
